{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "BACKEND_URL",
    "NEXT_PUBLIC_APP_URL",
    "DATABASE_URL",
    "DIRECT_URL",
    "JWT_SECRET",
    "PORT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "BACKEND_URL",
        "NEXT_PUBLIC_APP_URL",
        "NODE_ENV",
        "DATABASE_URL",
        "DIRECT_URL",
        "JWT_SECRET",
        "PORT"
      ]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "prisma:generate": {
      "cache": false
    }
  }
}
