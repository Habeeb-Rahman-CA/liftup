generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------
enum Role {
  USER
  ADMIN
}

enum WorkoutSessionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  SKIPPED
  REST
}

enum SetType {
  WARMUP
  WORKING
}

// -----------------------------------------------------------------------------
// USER & AUTH DOMAIN
// -----------------------------------------------------------------------------
model User {
  id               String            @id @default(cuid())
  email            String            @unique
  passwordHash     String
  name             String?
  avatar           String?
  timezone         String?           @default("UTC")
  role             Role              @default(USER)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  // Auth & Session Relations
  refreshTokens    RefreshToken[]

  // Workout Relations
  workoutSchedules WorkoutSchedule[]
  workoutSessions  WorkoutSession[]

  // Meal Domain Relations
  mealPlans        MealPlan[]
  mealDayLogs      MealDayLog[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

// -----------------------------------------------------------------------------
// WORKOUT DOMAIN
// -----------------------------------------------------------------------------

/// Reusable template/routine schedule (e.g., "Push Pull Legs", "Upper Lower")
model WorkoutSchedule {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isActive    Boolean      @default(true)
  days        WorkoutDay[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId])
}

/// Day defined within a workout schedule (e.g., "Leg Day", "Push Day")
model WorkoutDay {
  id          String               @id @default(cuid())
  scheduleId  String
  schedule    WorkoutSchedule      @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  name        String
  dayOfWeek   Int                  // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  isRestDay   Boolean              @default(false)
  description String?
  exercises   WorkoutDayExercise[]
  sessions    WorkoutSession[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([scheduleId])
  @@index([dayOfWeek])
}

/// Exercise assigned to a specific workout day routine
model WorkoutDayExercise {
  id            String     @id @default(cuid())
  workoutDayId  String
  workoutDay    WorkoutDay @relation(fields: [workoutDayId], references: [id], onDelete: Cascade)
  exerciseId    String
  exercise      Exercise   @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  targetSets    Int?       @default(3)
  targetRepsMin Int?       @default(8)
  targetRepsMax Int?       @default(12)
  orderIndex    Int        @default(0)
  note          String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([workoutDayId])
  @@index([exerciseId])
  @@index([orderIndex])
}

/// Master Exercise library catalog
model Exercise {
  id                  String               @id @default(cuid())
  name                String
  category            String               // e.g., CHEST, BACK, LEGS, SHOULDERS, ARMS, CORE, CARDIO
  description         String?
  instructions        String?
  defaultSets         Int?                 @default(3)
  defaultRepsMin      Int?                 @default(8)
  defaultRepsMax      Int?                 @default(12)
  orderIndex          Int                  @default(0)
  isActive            Boolean              @default(true)
  workoutDayExercises WorkoutDayExercise[]
  exerciseLogs        ExerciseLog[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([category])
  @@index([name])
  @@index([orderIndex])
  @@index([isActive])
}

/// Actual logged workout performance instance
model WorkoutSession {
  id              String               @id @default(cuid())
  userId          String
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutDayId    String?
  workoutDay      WorkoutDay?          @relation(fields: [workoutDayId], references: [id], onDelete: SetNull)
  name            String?
  status          WorkoutSessionStatus @default(PLANNED)
  skipReason      String?
  note            String?
  startedAt       DateTime?            @default(now())
  endedAt         DateTime?
  durationMinutes Int?
  exerciseLogs    ExerciseLog[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([userId])
  @@index([workoutDayId])
  @@index([status])
  @@index([startedAt])
}

/// Exercise performed during a workout session
model ExerciseLog {
  id               String         @id @default(cuid())
  workoutSessionId String
  workoutSession   WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  exerciseId       String
  exercise         Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  order            Int            @default(1)
  note             String?
  setLogs          SetLog[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([workoutSessionId])
  @@index([exerciseId])
}

/// Individual set metrics recorded within an exercise log
model SetLog {
  id            String      @id @default(cuid())
  exerciseLogId String
  exerciseLog   ExerciseLog @relation(fields: [exerciseLogId], references: [id], onDelete: Cascade)
  type          SetType     @default(WORKING)
  setNumber     Int
  reps          Int?
  weight        Float?
  rpe           Float?      // Rate of Perceived Exertion (1-10)
  completed     Boolean     @default(true)
  note          String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([exerciseLogId])
}

// -----------------------------------------------------------------------------
// MEAL DOMAIN
// -----------------------------------------------------------------------------

/// Reusable meal plan template (e.g. "Standard 4-Meal Plan")
model MealPlan {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isActive    Boolean       @default(true)
  meals       Meal[]
  dayLogs     MealDayLog[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
}

/// Planned meal within a meal plan (e.g., "Meal 1", "Meal 2", "Meal 3", "Meal 4")
model Meal {
  id          String     @id @default(cuid())
  mealPlanId  String
  mealPlan    MealPlan   @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  name        String
  orderIndex  Int        @default(0)
  time        String?    // e.g. "08:00 AM"
  items       MealItem[]
  mealLogs    MealLog[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([mealPlanId])
  @@index([orderIndex])
}

/// Food item assigned to a meal with quantity and unit
model MealItem {
  id              String        @id @default(cuid())
  mealId          String
  meal            Meal          @relation(fields: [mealId], references: [id], onDelete: Cascade)
  name            String        // e.g., "Whole Egg", "Chicken Breast", "Oats", "Rice"
  quantity        Float?        // e.g., 4, 150, 40, 10
  unit            String?       // e.g., "pcs", "g", "ml", "Rotis/Chappati"
  displayQuantity String?       // e.g., "4 Whole Egg", "150g Chicken Breast"
  orderIndex      Int           @default(0)
  itemLogs        MealItemLog[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([mealId])
  @@index([orderIndex])
}

/// Daily nutrition log instance tracking a single calendar day's eating
model MealDayLog {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mealPlanId String?
  mealPlan   MealPlan? @relation(fields: [mealPlanId], references: [id], onDelete: SetNull)
  date       String    // "YYYY-MM-DD" e.g., "2026-09-25"
  note       String?
  mealLogs   MealLog[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

/// Log of an individual meal for a specific day
model MealLog {
  id           String        @id @default(cuid())
  mealDayLogId String
  mealDayLog   MealDayLog    @relation(fields: [mealDayLogId], references: [id], onDelete: Cascade)
  mealId       String?
  meal         Meal?         @relation(fields: [mealId], references: [id], onDelete: SetNull)
  name         String        // e.g., "Meal 1"
  orderIndex   Int           @default(0)
  completed    Boolean       @default(false)
  completedAt  DateTime?
  note         String?
  itemLogs     MealItemLog[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([mealDayLogId])
  @@index([mealId])
}

/// Log of an individual food item within a meal log
model MealItemLog {
  id              String    @id @default(cuid())
  mealLogId       String
  mealLog         MealLog   @relation(fields: [mealLogId], references: [id], onDelete: Cascade)
  mealItemId      String?
  mealItem        MealItem? @relation(fields: [mealItemId], references: [id], onDelete: SetNull)
  name            String
  quantity        Float?
  unit            String?
  displayQuantity String?
  completed       Boolean   @default(false)
  orderIndex      Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([mealLogId])
  @@index([mealItemId])
}

// -----------------------------------------------------------------------------
// SYSTEM / HEALTH
// -----------------------------------------------------------------------------
model HealthCheck {
  id        String   @id @default(cuid())
  status    String   @default("ok")
  checkedAt DateTime @default(now())
}
